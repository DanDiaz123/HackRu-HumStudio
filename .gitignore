# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design tool logs
/.impeccable/questions/

# stale compiled tests from an old runner
/.test-build/

# design-tool review screenshots (generated)
/.impeccable/review/

# Private engineering documentation; the public README and license are retained.
*.md
!/README.md
!/LICENSE.md

# Local agent configuration and design-tool state
/.agents/
/.codex/
/.aws/
/.impeccable/

# Local project exports and microphone take fixtures
*.humstudio.json
/src/tests/takes/*
!/src/tests/takes/.gitkeep
